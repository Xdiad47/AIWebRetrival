# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
TAVILY_API_KEY=
GROQ_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b   # run `npm run models` to see what your key can use
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint (e.g. vLLM on the AMD notebook)
# LLM_API_KEY=                          # overrides GROQ_API_KEY when LLM_BASE_URL points elsewhere
# RATE_LIMIT_PER_10_MIN=15
